<!--
  Configuración de Windows Sandbox para probar Ariadna sin instalarla en tu equipo.
  Abre este archivo con doble clic (Windows 11 Pro, con la característica
  "Containers-DisposableClientVM" activada). Edita HostFolder si guardas el
  instalador en otra carpeta.
-->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\javie\Downloads</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\Descargas</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <Networking>Enable</Networking>
  <MemoryInMB>4096</MemoryInMB>
  <LogonCommand>
    <Command>explorer.exe C:\Users\WDAGUtilityAccount\Desktop\Descargas</Command>
  </LogonCommand>
</Configuration>
