#!/bin/sh
# Scans what is about to be committed. The repo is public.
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "gitleaks is not on the PATH." >&2
    echo "Install it (brew install gitleaks) and retry the commit." >&2
    exit 1
fi
gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
