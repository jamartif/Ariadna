{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal: núcleo de Tauri (eventos), diálogos nativos, los cinco controles de ventana que dibuja la interfaz y abrir URL https de una lista cerrada. Sin shell ni fs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://learn.microsoft.com/*" },
        { "url": "https://dev.azure.com/*" },
        { "url": "https://*.visualstudio.com/*" },
        { "url": "https://github.com/*" },
        { "url": "https://docs.github.com/*" },
        { "url": "https://gitlab.com/*" },
        { "url": "https://docs.gitlab.com/*" },
        { "url": "https://bitbucket.org/*" },
        { "url": "https://support.atlassian.com/*" }
      ]
    }
  ]
}
